{
  "name": "build-frontend-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Build process for frontend assets",
  "main": "index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "bundle": "node build.mjs \"assets-src/*.js\" -o \"assets\"",
    "watch": "pnpm bundle",
    "build": "pnpm bundle --production"
  },
  "author": "Rasso Hilber",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "browserslist": "^4.29.4",
    "esbuild": "^0.28.2",
    "esbuild-plugin-browserslist": "^4.0.0",
    "postcss": "^8.5.31",
    "postcss-preset-env": "^11.6.1",
    "sass": "^1.106.1"
  },
  "dependencies": {
    "feather-icons": "^4.28.0"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15",
    "ios >= 15"
  ],
  "packageManager": "pnpm@12.4.2"
}
